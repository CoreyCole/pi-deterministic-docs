{
  "name": "pi-deterministic-docs",
  "version": "0.1.0",
  "description": "Pi extension that deterministically injects nearest project docs when files are read.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "deterministic-docs",
    "agents-md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/CoreyCole/pi-deterministic-docs.git"
  },
  "packageManager": "pnpm@10.32.1",
  "pi": {
    "extensions": [
      "./extensions/deterministic-docs"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@types/node": "^24.12.4",
    "typescript": "^5.9.3",
    "vitest": "4.1.9"
  },
  "scripts": {
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "check": "pnpm test && pnpm typecheck"
  }
}
