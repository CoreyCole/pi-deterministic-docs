{
  "name": "pi-deterministic-docs",
  "version": "0.1.0",
  "description": "Pi extension that deterministically injects nearest project docs when files are read.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "deterministic-docs",
    "agents-md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/CoreyCole/pi-deterministic-docs.git"
  },
  "pi": {
    "extensions": [
      "./extensions/deterministic-docs"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.74.0",
    "@earendil-works/pi-coding-agent": "0.74.0",
    "@types/node": "^20.19.26",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "check": "tsc --noEmit"
  }
}
